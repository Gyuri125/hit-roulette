# Supabase Realtime konfiguráció (kötelező az élő TV <-> mobil szinkronhoz)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Szerveroldali belépési PIN és HMAC aláíró kulcs (éles/production környezetben KÖTELEZŐ!)
MASTER_PIN=303646
PIN_SECRET=replace-with-a-long-random-hex-or-base64-secret

